{
  "model": "yolov12",
  "ap_definition": "per-image COCO AP@[0.50:0.95] (COCOeval stats[0])",
  "minimum_sample_ap_exclusive": 0.4,
  "validation_ap_threshold": 0.5,
  "selection_note": "One source image per dataset is used for all three brightness versions. Six examples are supplied, with a balanced four-image subset retained. The latest competition requirement places the HSV error on the in-range version instead of the too-bright version: increasing brightness further cannot reverse an HSV too-bright prediction.",
  "selection_policy": "Curated illustrative examples, not a random or representative sample. All AP > 0.4. Bright/dark examples have AP < 0.5 and gamma < 1 / > 1; in-range examples have AP >= 0.5 and may be transformed. Both methods make definite predictions. Competition in-range is correctly accepted by RMS and falsely rejected as too bright by HSV. Validation bright is an HSV true positive.",
  "shared_source_per_dataset": {
    "competition_dataset": "data/base_images/comp_labelled/images/000143_8d7dca83-frame_001764_1721555072488452212.png",
    "val": "data/base_images/val/images/prom_00308.jpg"
  },
  "correctness_definition": "methods.correct compares the directional classification to the AP-and-transformation reference. failure_detection_correct preserves the saved binary success/failure correctness. A too-dark prediction for an actual too-bright failure detects failure correctly but has the wrong direction, labeled explicitly in the figures.",
  "reference_definition": "AP >= 0.5 means in_range. AP < 0.5 with side bright/dark means too_bright/too_dark. These are operational AP-based categories, not independent visual exposure labels.",
  "prediction_rule": "Use saved three_class predictions (boundary mean +/- 0.204 sample SD). For saved out_of_range, scores below the dark band's lower limit are too_dark and scores above the bright band's upper limit are too_bright. Inclusive boundary bands are uncertain; their intervening open interval is in_range.",
  "image_reproduction": "Original decoded pixels or repository imgDarkBright gamma LUT, followed by the source-extension encoding used in validation, then lossless PNG export. No crop, resize, or visual enhancement. Both exported-pixel scores verified against saved values to 1e-12; AP reused without inference.",
  "recommended_four_sample_ids": [
    "comp_data_too_bright",
    "val_data_too_bright",
    "comp_data_in-range",
    "val_data_too_dark"
  ],
